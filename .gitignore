__pycache__/
.pytest_cache/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Job logs live beside the code so `tail -f logs/...` is convenient; the repo
# is on the mounted volume, so they persist. They are never committed.
logs/
*.log
*.out

# Generated images, metric outputs and local source backups.
results/
*.pt
*.ckpt

# Persisted environment and caches, if CLG_PERSIST points inside the repository
# rather than at its parent. See vlab_env.sh.
envs/
hf/
pip-cache/
conda/
git/

# Reference image sets for FID are large and not ours to redistribute.
# Prepared manifests are embedded in each saved run plan.
data/reference/
data/annotations/
data/downloads/
data/benchmarks/
data/weights/
external/
.venv-*/

# The paper PDF is not ours to redistribute; the write-up in docs/ is tracked.
docs/*.pdf
